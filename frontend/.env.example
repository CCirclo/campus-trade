PORT=8787
# 只监听回环地址，防止 API 直接暴露公网；生产环境请保持 127.0.0.1
HOST=127.0.0.1
APP_ORIGIN=http://localhost:5173
VITE_BASE_PATH=/
SESSION_DAYS=30

# MySQL：建议为本项目创建独立数据库和最小权限用户。
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=campus_market
MYSQL_USER=campus_market_app
MYSQL_PASSWORD=replace-with-a-strong-password
MYSQL_CONNECTION_LIMIT=10
SEED_DEMO_DATA=false

# 管理员邮箱（逗号分隔）。服务启动时会将对应账号自动提升为管理员。
# 也可运行: npx tsx scripts/make-admin.ts someone@example.com
ADMIN_EMAILS=

# 腾讯云 COS（沿用服务器已有账号时，也请为本项目限定桶权限）
COS_SECRET_ID=
COS_SECRET_KEY=
COS_BUCKET=
COS_REGION=
COS_PUBLIC_BASE_URL=

# QQ 邮箱 SMTP，用于邮箱注册验证码
EMAIL_HOST=smtp.qq.com
EMAIL_PORT=465
EMAIL_SECURE=true
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=

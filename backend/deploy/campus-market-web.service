[Unit]
Description=Campus Market Web
After=network-online.target mysql.service
Wants=network-online.target

[Service]
Type=simple
User=campus-market
Group=campus-market
WorkingDirectory=/srv/campus-market/current
EnvironmentFile=/etc/campus-market/.env
ExecStart=/usr/bin/npm start
Restart=on-failure
RestartSec=5
TimeoutStopSec=15
MemoryHigh=384M
MemoryMax=512M
TasksMax=128
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target

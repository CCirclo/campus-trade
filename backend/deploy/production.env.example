# Install as /etc/campus-market/.env with mode 600. Fill secrets on the server;
# never commit the real file.
NODE_ENV=production
PORT=8787
HOST=127.0.0.1
APP_ORIGIN=https://20250821cdcdifc.top
VITE_BASE_PATH=/campus-trade/
SESSION_DAYS=30

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=campus_market
MYSQL_USER=campus_market_app
MYSQL_PASSWORD=replace-on-server
MYSQL_CONNECTION_LIMIT=10
SEED_DEMO_DATA=false

# 行为分析：建议使用随机生成且互不相同的密钥。缺失时服务会独立生成并持久化。
ANALYTICS_HASH_SECRET=replace-with-at-least-32-random-characters
CURSOR_SIGNING_SECRET=replace-with-another-32-character-secret

# 推荐先保持关闭；预发布回放与指标检查通过后从 5% 开始灰度。
RECOMMENDATION_ENABLED=false
RECOMMENDATION_ROLLOUT_PERCENT=0
RECOMMENDATION_ALGORITHM_VERSION=home-rules-v1

# 语义检索使用 OpenAI-compatible /embeddings 服务。不开启时自动回退关键词搜索。
EMBEDDING_ENABLED=false
HYBRID_SEARCH_ENABLED=false
EMBEDDING_API_URL=https://embedding.example.com/v1/embeddings
EMBEDDING_API_KEY=
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
EMBEDDING_MODEL_VERSION=bge-small-zh-v1.5@1
EMBEDDING_DIMENSIONS=512
EMBEDDING_TIMEOUT_MS=5000
EMBEDDING_BATCH_SIZE=1
EMBEDDING_MAX_PENDING=8
EMBEDDING_VECTOR_SCAN_LIMIT=500
HYBRID_SPARSE_RESULT_THRESHOLD=12

ADMIN_EMAILS=
COS_SECRET_ID=
COS_SECRET_KEY=
COS_BUCKET=
COS_REGION=
COS_PUBLIC_BASE_URL=

EMAIL_HOST=smtp.qq.com
EMAIL_PORT=465
EMAIL_SECURE=true
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=

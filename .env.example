PORT=8787
# 只监听回环地址，防止 API 直接暴露公网；生产环境请保持 127.0.0.1
HOST=127.0.0.1
APP_ORIGIN=http://localhost:5173
VITE_BASE_PATH=/
SESSION_DAYS=30

# MySQL：建议为本项目创建独立数据库和最小权限用户。
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=campus_market
MYSQL_USER=campus_market_app
MYSQL_PASSWORD=replace-with-a-strong-password
MYSQL_CONNECTION_LIMIT=10
SEED_DEMO_DATA=false
# 空数据库首次初始化种子；初始化后请在 Admin 学校页面维护。保持单行 JSON。
# SCHOOL_CATALOG_JSON=[{"id":"ruc","name":"中国人民大学","emailDomains":["ruc.edu.cn"],"campuses":[{"id":"suzhou","name":"苏州校区"}]}]

# 推荐/分析（生产建议配置两个不同的 32+ 字符随机密钥）
ANALYTICS_HASH_SECRET=
CURSOR_SIGNING_SECRET=
RECOMMENDATION_ENABLED=false
RECOMMENDATION_ROLLOUT_PERCENT=0
RECOMMENDATION_ALGORITHM_VERSION=home-rules-v1

# 本地语义/混合搜索；开发环境默认关闭
EMBEDDING_ENABLED=false
HYBRID_SEARCH_ENABLED=false
EMBEDDING_API_URL=http://127.0.0.1:8080/v1/embeddings
EMBEDDING_API_KEY=
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
EMBEDDING_MODEL_VERSION=bge-small-zh-v1.5@1
EMBEDDING_DIMENSIONS=512
EMBEDDING_TIMEOUT_MS=5000
EMBEDDING_BATCH_SIZE=1
EMBEDDING_MAX_PENDING=8
EMBEDDING_VECTOR_SCAN_LIMIT=500
HYBRID_SPARSE_RESULT_THRESHOLD=12

# 管理员邮箱（逗号分隔）。服务启动时会将对应账号自动提升为管理员。
# 也可运行: npx tsx scripts/make-admin.ts someone@example.com
ADMIN_EMAILS=

# 腾讯云 COS（沿用服务器已有账号时，也请为本项目限定桶权限）
COS_SECRET_ID=
COS_SECRET_KEY=
COS_BUCKET=
COS_REGION=
COS_PUBLIC_BASE_URL=

# QQ 邮箱 SMTP，用于邮箱注册验证码
EMAIL_HOST=smtp.qq.com
EMAIL_PORT=465
EMAIL_SECURE=true
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=

# APNs（iOS 系统推送，全部可选）。缺失时站内消息与邮件通知不受影响，仅无法真实远程送达。
# APNS_KEY_ID / APNS_TEAM_ID / APNS_TOPIC 与私钥（APNS_AUTH_KEY_PATH 或 APNS_AUTH_KEY_BASE64）齐备才会启用。
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_TOPIC=
APNS_AUTH_KEY_PATH=
APNS_AUTH_KEY_BASE64=
# Apple App Site Association：Associated Domains 所用 appID 前缀（团队 ID）。外部凭据项。
APPLE_APP_ID_PREFIX=
IOS_BUNDLE_ID=com.ccirclo.ios
